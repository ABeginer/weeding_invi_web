# ---- Supabase (server-side only) ----
# URL của project, ví dụ https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) dùng ở server; không đặt trong mã client.
SUPABASE_SECRET_KEY=

# ---- Auth0 ----
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# ---- URL công khai (canonical, Open Graph, sitemap) ----
# Production phải là domain thật; nếu bỏ trống code sẽ fallback về localhost:3000.
APP_BASE_URL=
SITE_URL=
NEXT_PUBLIC_SITE_URL=
# Tuỳ chọn: đổi tên thương hiệu, mặc định "Inviwedd".
NEXT_PUBLIC_SITE_NAME=

# ---- Cloudflare Turnstile (chống spam RSVP / lời chúc) ----
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Ops console ----
# Danh sách email admin, phân tách bằng dấu phẩy. Bỏ trống = không ai vào được /ops.
ADMIN_EMAIL=

# ---- Thanh toán chuyển khoản (VietQR + webhook) ----
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# Shared secret mà Google Apps Script gửi trong header x-webhook-secret.
BANK_WEBHOOK_SECRET=

# ---- Tuỳ chọn ----
# "true" để hiện tên khách trong tiêu đề Open Graph của /m/[slug].
SHARE_SHOW_GUEST_NAME=false
# Token Cloudflare Web Analytics; bỏ trống thì không chèn script.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
