\"}]\\n8:X\\ne:T864,[{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebApplication\\\",\\\"name\\\":\\\"Đổi ngày dương sang âm lịch\\\",\\\"description\\\":\\\"Chuyển đổi ngày dương lịch sang âm lịch và ngược lại (1900–2100) kèm can chi năm, tháng, ngày theo giờ Việt Nam để tham khảo ngày cưới.\\\",\\\"url\\\":\\\"http://localhost:3000/cong-cu/doi-am-lich\\\",\\\"inLanguage\\\":\\\"vi\\\",\\\"applicationCategory\\\":\\\"UtilitiesApplication\\\",\\\"operatingSystem\\\":\\\"Web\\\",\\\"offers\\\":{\\\"@type\\\":\\\"Offer\\\",\\\"price\\\":\\\"0\\\",\\\"priceCurrency\\\":\\\"VND\\\"}},{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Công cụ tính âm lịch theo múi giờ nào?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Thuật toán luôn quy đổi theo múi giờ Việt Nam (Asia/Ho_Chi_Minh, UTC+7) dựa trên ngày Sóc và Trung khí để tránh sai lệch ngày khi bạn mở công cụ ở nước ngoài hoặc thiết bị đặt sai múi giờ.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Tháng nhuận âm lịch được xử lý ra sao?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Khi chuyển từ dương sang âm, công cụ tự động đánh dấu tháng nhuận nếu ngày đó rơi vào tháng nhuận. Khi đổi ngược từ âm sang dương, bạn có thể chọn ô Tháng nhuận và công cụ sẽ kiểm tra xem năm âm lịch đó có đúng tháng nhuận này hay không.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Tôi có thể dùng kết quả này để chốt ngày cưới ngay không?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Kết quả mang tính tham khảo kỹ thuật theo thuật toán lịch thiên văn phổ biến. Trước khi ấn định các mốc lễ quan trọng hoặc in ấn, hai gia đình nên đối chiếu thêm với lịch chính thức đang lưu hành.\\\"}}]},{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position