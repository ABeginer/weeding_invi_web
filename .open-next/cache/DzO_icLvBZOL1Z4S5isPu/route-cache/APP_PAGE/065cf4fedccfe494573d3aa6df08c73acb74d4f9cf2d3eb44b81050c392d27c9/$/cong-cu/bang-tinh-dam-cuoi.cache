$\\\",\\\"dd\\\",null,{\\\"className\\\":\\\"mt-1.5 text-sm leading-relaxed text-text-muted\\\",\\\"children\\\":\\\"Không. Mọi phép tính đều chạy trên trình duyệt của bạn và không gửi dữ liệu về máy chủ Inviwedd. Thông tin chỉ được ghi vào bộ nhớ trình duyệt (localStorage) khi bạn chủ động bấm nút Lưu bảng tính.\\\"}]]}]]}]]}]\\n14:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-8 rounded-2xl border border-border bg-surface p-6 sm:p-8 print:hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-text\\\",\\\"children\\\":\\\"Đã có danh sách khách? Tạo link mời riêng cho từng người\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-1.5 text-sm leading-relaxed text-text-muted\\\",\\\"children\\\":\\\"Khởi tạo thiệp cưới cá nhân hóa theo từng vị khách mời và thu thập xác nhận tham dự tự động để chốt số bàn chuẩn xác.\\\"}]]}],[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tao-thiep\\\",\\\"className\\\":\\\"inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-full bg-accent px-6 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Tạo thiệp miễn phí\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-arrow-right h-4 w-4\\\",\\\"aria-hidden\\\":\\\"true\\\",