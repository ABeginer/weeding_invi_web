5gdzqknx46iu.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/83940f62350fcaa7-s.p.13y-iz2lazqtb.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/b4fb5dfe9580f890-s.p.1zvg0ggiaivzo.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/b57845f0cf557e59-s.p.1xtu7gopqv2u0.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/c3d9c74ef0d9c07b-s.p.23aeddxv5enbo.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/dd018b41519c2d93-s.p.2g-0we2o5_ngd.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/f36d61f2f30b50ce-s.p.22x-ws2e_cdqh.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n8:X\\nf:Tc83,[{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebApplication\\\",\\\"name\\\":\\\"Bảng tính chi phí đám cưới online\\\",\\\"description\\\":\\\"Ước tính chi phí đám cưới, số bàn tiệc dự phòng và số lượt mừng hòa vốn theo giá mâm thực tế. Chạy ngay trên trình duyệt, không lưu máy chủ.\\\",\\\"url\\\":\\\"http://localhost:3000/cong-cu/bang-tinh-dam-cuoi\\\",\\\"inLanguage\\\":\\\"vi\\\",\\\"applicationCategory\\\":\\\"UtilitiesApplication\\\",\\\"operatingSystem\\\":\\\"Web\\\",\\\"offers\\\":{\\\"@type\\\":\\\"Offer\\\",\\\"price\\\":\\\"0\\\",\\\"priceCurrency\\\":\\\"VND\\\"}},{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Chi phí đám cưới thường gồm những khoản nào?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Các khoản phổ biến thường gồm tiệc thực đơn, địa điểm, trang trí, nhiếp ảnh, quay phim, trang phục và trang điểm, lễ vật ăn hỏi, thiệp mời, di chuyển, âm thanh ánh sáng và chi phí dự phòng. Danh sách trong bảng tính chỉ mang tính tham khảo; bạn có thể giữ, bỏ trống hoặc thêm khoản riêng phù hợp với lễ cưới của mình.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Làm sao để ước tính số bàn tiệc?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Bạn lấy số khách mời nhân với tỉ lệ đến dự để ra số khách chính, cộng thêm số người đi cùng trung bình để ước tính tổng số người, rồi chia cho số khách mỗi bàn và cộng thêm tỉ lệ bàn dự phòng theo thói quen của nhà hàng hoặc gia đình.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Tiền mừng trung bình là bao nhiêu?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Không có con số chung cố định cho mọi đám cưới. Mức tiền mừng phụ thuộc vào vùng miền, loại hình địa điểm, mối quan hệ thân sơ và điều kiện của từng gia đình, vì vậy bạn nên tham khảo thêm từ người thân hoặc bạn bè vừa tổ chức gần đây tại địa phương.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Vì sao cần tính số lượt mừng để hòa vốn?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Con số lượt mừng hòa vốn giúp cô dâu chú rể hình dung tương quan giữa ngân sách tổng và lượng khách mời thực tế khi lập kế hoạch tài chính, từ đó chủ động cân đối các hạng mục hoặc quỹ dự phòng.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Công cụ có lưu thông tin của tôi không?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Không. Mọi phép tính đều chạy trên trình duyệt của bạn và không gửi dữ liệu về máy chủ Inviwedd. Thông tin chỉ được ghi vào bộ nhớ trình duyệt (localStorage) khi bạn chủ động bấm nút Lưu bảng tính.\\\"}}]},{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Trang chủ\\\",\\\"item\\\":\\\"http://localhost:3000/\\\"},{\\