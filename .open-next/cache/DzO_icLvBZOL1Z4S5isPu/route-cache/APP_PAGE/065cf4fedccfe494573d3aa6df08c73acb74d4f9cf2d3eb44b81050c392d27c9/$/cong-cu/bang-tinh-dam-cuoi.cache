ng\",\"className\":\"font-display text-2xl font-semibold text-text sm:text-3xl\",\"children\":\"Câu hỏi thường gặp\"}],[\"$\",\"dl\",null,{\"className\":\"mt-5 divide-y divide-border\",\"children\":[[\"$\",\"div\",\"Chi phí đám cưới thường gồm những khoản nào?\",{\"className\":\"py-4 first:pt-0 last:pb-0\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-sm font-semibold text-text sm:text-base\",\"children\":\"Chi phí đám cưới thường gồm những khoản nào?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-1.5 text-sm leading-relaxed text-text-muted\",\"children\":\"Các khoản phổ biến thường gồm tiệc thực đơn, địa điểm, trang trí, nhiếp ảnh, quay phim, trang phục và trang điểm, lễ vật ăn hỏi, thiệp mời, di chuyển, âm thanh ánh sáng và chi phí dự phòng. Danh sách trong bảng tính chỉ mang tính tham khảo; bạn có thể giữ, bỏ trống hoặc thêm khoản riêng phù hợp với lễ cưới của mình.\"}]]}],[\"$\",\"div\",\"Làm sao để ước tính số bàn tiệc?\",{\"className\":\"py-4 first:pt-0 last:pb-0\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-sm font-semibold text-text sm:text-base\",\"children\":\"Làm sao để ước tính số bàn tiệc?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-1.5 text-sm leading-relaxed text-text-muted\",\"children\":\"Bạn lấy số khách mời nhân với tỉ lệ đến dự để ra số khách chính, cộng thêm số người đi cùng trung bình để ước tính tổng số người, rồi chia cho số khách mỗi bàn và cộng thêm tỉ lệ bàn dự phòng theo thói quen của nhà hàng hoặc gia đình.\"}]]}],[\"$\",\"div\",\"Tiền mừng trung bình là bao nhiêu?\",{\"className\":\"py-4 first:pt-0 last:pb-0\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-sm font-semibold text-text sm:text-base\",\"children\":\"Tiền mừng trung bình là bao nhiêu?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-1.5 text-sm leading-relaxed text-text-muted\",\"children\":\"Không có con số chung cố định cho mọi đám cưới. Mức tiền mừng phụ thuộc vào vùng miền, loại hình địa điểm, mối quan hệ thân sơ và điều kiện của từng gia đình, vì vậy bạn nên tham khảo thêm từ người thân hoặc bạn bè vừa tổ chức gần đây tại địa phương.\"}]]}],[\"$\",\"div\",\"Vì sao cần tính số lượt mừng để hòa vốn?\",{\"className\":\"py-4 first:pt-0 last:pb-0\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-sm font-semibold text-text sm:text-base\",\"children\":\"Vì sao cần tính số lượt mừng để hòa vốn?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-1.5 text-sm leading-relaxed text-text-muted\",\"children\":\"Con số lượt mừng hòa vốn giúp cô dâu chú rể hình dung tương quan giữa ngân sách tổng và lượng khách mời thực tế khi lập kế hoạch tài chính, từ đó chủ động cân đối các hạng mục hoặc quỹ dự phòng.\"}]]}],[\"$\",\"div\",\"Công cụ có lưu thông tin của tôi không?\",{\"className\":\"py-4 first:pt-0 last:pb-0\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-sm font-semibold text-text sm:text-base\",\"children\":\"Công cụ có lưu thông tin của tôi không?\"}],[\"$\",\"dd\",null,{\"className\":\"mt-1.5 text-sm leading-relaxed text-text-muted\",\"children\":\"Không. Mọi phép tính đều chạy trên trình duyệt của bạn và không gửi dữ liệu về máy chủ Inviwedd. Thông tin chỉ được ghi vào bộ nhớ trình duyệt (localStorage) khi bạn chủ động bấm nút Lưu bảng tính.\"}]]}]]}]]}]\n23:[\"$\",\"section\",null,{\"className\":\"mt-8 rounded-2xl border border-border bg-surface p-6 sm:p-8 print:hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-xl\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-text\",\"children\":\"Đã có danh sách khách? Tạo link mời riêng cho từng người\"}],[\"$\",\"p\",null,{\"className\":\"mt-1.5 text-sm leading-relaxed text-text-muted\",\"children\":\"Khởi tạo thiệp cưới cá nhân hóa theo từng vị khách mời và thu thập xác nhận tham dự tự động để chốt số bàn chuẩn xác.\"}]]}],[\"$\",\"$L1d\",null,{\"href\":\"/tao-thiep\",\"className\":\"inli