{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker-entry.ts",
	"name": "wedding-invitation",
	"compatibility_date": "2026-11-12",
	"triggers": {
		// 03:00 UTC mỗi ngày: job dọn thiệp gói free quá 30 ngày.
		"crons": [
			"0 3 * * *"
		]
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "wedding-invitation"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "thiep-cuoi-photos"
		}
	],
	"env": {
		"staging": {
			"name": "wedding-invitation-staging",
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://wedding-invitation-staging.inviwedd.workers.dev",
				"APP_BASE_URL": "https://wedding-invitation-staging.inviwedd.workers.dev"
			},
			"services": [
				{
					// Self-reference service binding, the service name must match the worker name
					// see https://opennext.js.org/cloudflare/caching
					"binding": "WORKER_SELF_REFERENCE",
					"service": "wedding-invitation-staging"
				}
			],
			"r2_buckets": [
				{
					"binding": "PHOTOS",
					"bucket_name": "thiep-cuoi-photos"
				}
			]
		}
	}
}